# 复制为 .env 后逐项替换；此文件只含不可用占位符，禁止提交真实凭证。
# PostgreSQL 和 API 启动必填；数据库名/用户/密码都不得沿用仓库默认值。
DRT_OPS_DATABASE=REPLACE_WITH_DATABASE_NAME
DRT_OPS_DATASOURCE_USERNAME=REPLACE_WITH_DATABASE_USER
DRT_OPS_DATASOURCE_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD

# API 安全配置必填；JWT、管理员密码和地图 key 必须由部署环境提供。
DRT_AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
DRT_AUTH_BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_ADMIN_LOGIN_ALIAS
DRT_AUTH_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD
DRT_AMAP_WEB_SERVICE_KEY=REPLACE_WITH_DEPLOYMENT_MAP_KEY

# 网关访问运营 API 的地址。使用受控内网域名或 TLS 地址，不要填写公网裸 IP。
JT_GATEWAY_OPERATIONS_API_BASE_URL=https://replace-with-operations-api.invalid

# 当前服务凭证版本必须是正整数；明文只进入 jt-gateway，SHA-256 只进入 API。
JT_GATEWAY_SERVICE_CREDENTIAL_VERSION=REPLACE_WITH_POSITIVE_INTEGER
JT_GATEWAY_SERVICE_CREDENTIAL_PLAINTEXT=REPLACE_WITH_LONG_RANDOM_SECRET
JT_GATEWAY_SERVICE_CREDENTIAL_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_SHA256

# 凭证轮换窗口：未启用上一版本时保持为空，API 不接收上一版本明文。
JT_GATEWAY_PREVIOUS_SERVICE_CREDENTIAL_VERSION=
JT_GATEWAY_PREVIOUS_SERVICE_CREDENTIAL_SHA256=

# 每个实例使用不含主机敏感信息的稳定标识。
JT_GATEWAY_INSTANCE=REPLACE_WITH_GATEWAY_INSTANCE_ALIAS

# H2 使用显式命名卷，便于备份恢复时切换到新卷并保留旧卷回退。
JT_GATEWAY_DATA_VOLUME=REPLACE_WITH_GATEWAY_DATA_VOLUME_NAME

# HTTP timeout 必须为正数且严格小于 60000ms delivery lease。
JT_GATEWAY_HTTP_CONNECT_TIMEOUT_MS=2000
JT_GATEWAY_HTTP_READ_TIMEOUT_MS=5000

# 运营 API 成功/失败事实超过此秒数即失效；默认30秒，主动探针每10秒刷新一次。
JT_GATEWAY_API_STATUS_TTL_SECONDS=30

# 仅决定宿主机映射端口；容器内设备端口固定为 7611。
JT_GATEWAY_TCP_PORT=7611
